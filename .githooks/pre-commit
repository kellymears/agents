#!/bin/sh
# Format staged markdown with dprint and re-stage the result.
# Activated via `git config core.hooksPath .githooks` (npm "prepare" script).

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md')
[ -z "$staged" ] && exit 0

npx dprint fmt --staged || exit 1

echo "$staged" | while IFS= read -r file; do
  [ -f "$file" ] && git add -- "$file"
done
